# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# live data — no longer committed; fetched dynamically from Azure Data Lake
# (lib/etl/pipeline.js) and Azure SQL via the CPI Function proxy
# (lib/azure/cpi.js) at request time, cached server-side.
/data/*.json
/data/*.csv

# EXCEPTIONS -- these ARE committed on purpose, despite the blanket rule
# above. basket_prices.json and productMap.json are statically IMPORTED at
# build time (lib/basketData.js, lib/etl/productMap.js) -- if either is
# missing, `next build` fails outright with "Module not found" (confirmed:
# this is what broke the Vercel build). classes.csv is the source-of-truth
# category-mapping input scripts/build_basket.py reads. None of these three
# are live caches; they must stay tracked.
!/data/basket_prices.json
!/data/classes.csv
!/data/productMap.json
